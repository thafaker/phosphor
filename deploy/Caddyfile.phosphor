# Phosphor — statisches SPA-Deployment hinter Caddy.
#
# Diesen Block in /etc/caddy/Caddyfile einfügen (die Instanz nutzt eine einzige,
# zentrale Caddyfile ohne `import`). Danach: `sudo caddy validate --config
# /etc/caddy/Caddyfile && sudo systemctl reload caddy`.
#
# Bewusst OHNE basicauth: Phosphor ist ein reiner OAuth-Client, der Login läuft
# gegen social.janmontag.de. Ein Basic-Auth-Prompt würde den OAuth-Rücksprung
# auf /callback und das „Zum Home-Bildschirm"-Verhalten stören.

phosphor.janmontag.de {
	encode zstd gzip

	root * /var/www/phosphor

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Gehashte Bundles dürfen dauerhaft gecacht werden. Die Matcher sind bewusst
	# gegenseitig ausschließend (`not`), damit die Reihenfolge keine Rolle spielt.
	# `path_regexp` statt Glob, weil ein Glob-`*` keine Pfadsegmente über `/` hinweg
	# erfasst und die Bundles in Unterordnern liegen.
	@immutable path_regexp ^/_app/immutable/
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Alles andere revalidieren, damit ein Deploy sofort sichtbar wird.
	@mutable not path_regexp ^/_app/immutable/
	header @mutable Cache-Control "no-cache"

	# Caddy 2.6 kennt die Endung .webmanifest nicht und liefert keinen Typ.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# SPA-Fallback: unbekannte Pfade (/settings, /status/…, /callback) an die
	# Client-Router-Index ausliefern, sonst gibt es 404.
	try_files {path} /index.html
	file_server

	log {
		output file /var/log/caddy/phosphor.janmontag_de.log
		format json
	}
}
